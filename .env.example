# Persistent CMS database (Turso/libSQL). Required in production.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Use a cryptographically random secret of at least 32 characters.
CMS_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# The first admin is created automatically when the database is empty.
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
CMS_ADMIN_NAME=HME Website Admin

# Website enquiry delivery (Resend). Verify hmeremit.com.my before using this sender.
RESEND_API_KEY=replace-with-your-resend-api-key
ENQUIRY_FROM_EMAIL=HME Website <website@hmeremit.com.my>
ENQUIRY_TO_EMAIL=info@hmeremit.com.my
ENQUIRY_ALLOWED_ORIGINS=https://hme-site.vercel.app,https://hmeremit.com.my,https://www.hmeremit.com.my

# Google Reviews (admin "Google Reviews" tab + homepage 5-star showcase).
# Requires a Google Cloud project with the Business Profile APIs enabled and
# an approved API access request — see README "Google Reviews setup".
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-oauth-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-your-oauth-client-secret
GOOGLE_OAUTH_REDIRECT_URI=https://your-deployment.vercel.app/api/admin/google-reviews/callback

# Free-tier AI used to draft review replies (https://aistudio.google.com/apikey).
# If omitted, simple template replies are used instead — the feature still works.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when
# triggering the daily review sync. Any long random string.
CRON_SECRET=replace-with-a-long-random-string
