# Persistent CMS database (Turso/libSQL). Required in production.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Use a cryptographically random secret of at least 32 characters.
CMS_AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# The first admin is created automatically when the database is empty.
CMS_ADMIN_EMAIL=admin@example.com
CMS_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
CMS_ADMIN_NAME=HME Website Admin
